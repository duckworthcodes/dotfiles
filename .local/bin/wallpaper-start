#!/bin/sh
# wallpaper-start: bring the wallpaper up at login, reliably.
#
# Why this exists: on Hyprland, swaybg sometimes gets launched by the
# autostart line before the monitor/output is fully ready. When that
# happens it exits immediately and silently -- nothing retries it, so
# you land on a blank/black screen until you run `theme` by hand.
#
# This wraps swaybg with a few retries, and only uses swww if BOTH the
# swww client and the swww-daemon binary are actually present (having
# just the client with no daemon is a real, silent-failure case).

WALL="$HOME/Pictures/wallpaper.jpg"
[ -f "$WALL" ] || WALL=""   # fall back to a solid colour if nothing set yet

start_once() {
    if command -v swww-daemon >/dev/null 2>&1 && command -v swww >/dev/null 2>&1; then
        swww-daemon >/dev/null 2>&1 &
        sleep 0.5
        if [ -n "$WALL" ]; then swww img "$WALL" --transition-type none; fi
        return $?
    elif [ -n "$WALL" ]; then
        swaybg -i "$WALL" -m fill &
    else
        swaybg -c 2a181b &
    fi
    pid=$!
    sleep 1
    kill -0 "$pid" 2>/dev/null   # 0 = still alive = success
}

for attempt in 1 2 3 4 5 6; do
    if start_once; then
        exit 0
    fi
    sleep 1
done
exit 1
