def qt_scheme_text():
    """KDE/Qt color scheme (Dolphin & co). Tokens are resolved by render()."""
    def sec(name, alt, normal, sel=False):
        fg = "SURFACE" if sel else None
        def f(tok):
            return "@%s_CSV@" % (fg or tok)
        return "\n".join([
            "[Colors:%s]" % name,
            "BackgroundAlternate=@%s_CSV@" % alt,
            "BackgroundNormal=@%s_CSV@" % normal,
            "DecorationFocus=@ACCENT_CSV@",
            "DecorationHover=@ACCENT_LIGHT_CSV@",
            "ForegroundActive=" + f("ACCENT"),
            "ForegroundInactive=" + f("FG_DIM"),
            "ForegroundLink=" + f("ACCENT"),
            "ForegroundNegative=" + f("ACCENT_DARK"),
            "ForegroundNeutral=" + f("YELLOW_BRIGHT"),
            "ForegroundNormal=" + f("FG"),
            "ForegroundPositive=" + f("GREEN"),
            "ForegroundVisited=" + f("MAGENTA"),
            "",
        ])

    return "\n".join([
        "[ColorEffects:Disabled]",
        "Color=56,56,56", "ColorAmount=0", "ColorEffect=0",
        "ContrastAmount=0.65", "ContrastEffect=1", "IntensityAmount=0.1", "IntensityEffect=2",
        "",
        "[ColorEffects:Inactive]",
        "ChangeSelectionColor=true", "Color=112,111,110", "ColorAmount=0.025", "ColorEffect=2",
        "ContrastAmount=0.1", "ContrastEffect=2", "Enable=false",
        "IntensityAmount=0", "IntensityEffect=0",
        "",
        sec("Button", "SURFACE", "SURFACE"),
        sec("Complementary", "VIEW", "BG"),
        sec("Header", "BG", "SURFACE"),
        sec("Selection", "ACCENT_DARK", "ACCENT", sel=True),
        sec("Tooltip", "BG", "SURFACE"),
        sec("View", "BG", "VIEW"),
        sec("Window", "SURFACE", "BG"),
        "[General]",
        "ColorScheme=@SCHEME@",
        "Name=@SCHEME@",
        "",
        "[WM]",
        "activeBackground=@SURFACE_CSV@",
        "activeForeground=@FG_CSV@",
        "inactiveBackground=@BG_CSV@",
        "inactiveForeground=@FG_DIM_CSV@",
        "",
    ])


