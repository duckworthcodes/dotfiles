_TX = {}  # shared with forked worker processes (see make_transition_gif)


def _tx_frame(i):
    """Render frame i of the transition. Runs in a worker process."""
    T = _TX
    w, h = T["size"]
    t = i / (T["frames"] - 1)
    e = t * t * (3.0 - 2.0 * t)          # smoothstep: slow start, fast middle, soft landing

    # the incoming wallpaper starts slightly zoomed in and settles to exactly 1.0x,
    # so the last frame is identical to the real static wallpaper (no pop on hand-off)
    zoom = 1.0 + T["zoom"] * (1.0 - t) ** 3
    if zoom > 1.0003:
        zw, zh = w / zoom, h / zoom
        box = ((w - zw) / 2, (h - zh) / 2, (w + zw) / 2, (h + zh) / 2)
        incoming = T["new"].resize((w, h), Image.Resampling.BICUBIC, box=box)
    else:
        incoming = T["new"]

    r = T["max_r"] * e
    if i == 0:
        frame = T["old"]
    elif r >= T["cover_r"]:
        frame = incoming                  # circle already covers the screen
    else:
        mw, mh = T["mask_size"]
        k = w / mw
        m = Image.new("L", (mw, mh), 0)
        rr = r / k
        ImageDraw.Draw(m).ellipse((mw / 2 - rr, mh / 2 - rr, mw / 2 + rr, mh / 2 + rr), fill=255)
        # the soft edge is blurry anyway, so build + blur the mask at 1/4 size and scale up:
        # visually identical to a supersampled mask, ~50x cheaper
        m = m.filter(ImageFilter.GaussianBlur(T["feather"])).resize((w, h), Image.Resampling.BICUBIC)
        frame = Image.composite(incoming, T["old"], m)

    return frame.quantize(palette=T["pal"], dither=Image.Dither.FLOYDSTEINBERG).tobytes()


def make_transition_gif(old_path, new_path, out_path, size=(1920, 1080),
                        frames=40, fps=50):
    """Eased, feathered radial reveal from the old wallpaper to the new one.

    Own implementation (no external transition tool). Design notes:
      * palette is built from BOTH wallpapers -- frames are almost entirely pure old/new
        pixels (only the soft edge is mixed), so a palette from a 50% blend shifts colors
      * fps=50 is exactly 2 hundredths of a second per frame, which GIF stores losslessly
        (60fps rounds to 10ms and plays back at the wrong speed)
      * frames are rendered in parallel across CPU cores, with a serial fallback
    """
    w, h = size
    old_img = Image.open(old_path).convert("RGB").resize(size, Image.Resampling.LANCZOS)
    new_img = Image.open(new_path).convert("RGB").resize(size, Image.Resampling.LANCZOS)

    sw, sh = w // 4, h // 4
    montage = Image.new("RGB", (sw, sh * 2))
    montage.paste(old_img.resize((sw, sh), Image.Resampling.BILINEAR), (0, 0))
    montage.paste(new_img.resize((sw, sh), Image.Resampling.BILINEAR), (0, sh))
    pal_img = montage.quantize(colors=256, method=Image.Quantize.MEDIANCUT)

    mask_size = (w // 4, h // 4)
    feather = 2.0
    _TX.clear()
    _TX.update(
        size=size, frames=frames, old=old_img, new=new_img, pal=pal_img,
        max_r=math.hypot(w, h) * 0.58, mask_size=mask_size, feather=feather, zoom=0.03,
        cover_r=math.hypot(w, h) / 2 + 4 * feather * (w / mask_size[0]),
    )

    data = None
    workers = min(os.cpu_count() or 1, 8)
    if workers > 1:
        try:
            import multiprocessing as mp
            with mp.get_context("fork").Pool(workers) as pool:
                data = pool.map(_tx_frame, range(frames))
        except Exception:
            data = None
    if data is None:
        data = [_tx_frame(i) for i in range(frames)]

    pal_bytes = pal_img.getpalette()
    out_frames = []
    for raw in data:
        f = Image.frombytes("P", size, raw)
        f.putpalette(pal_bytes)
        out_frames.append(f)
    out_frames.extend([out_frames[-1]] * int(fps * 0.6))  # hold on the final frame (free: merged in the GIF)

    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_frames[0].save(
        out_path, save_all=True, append_images=out_frames[1:],
        duration=int(1000 / fps), loop=1, optimize=False,
    )
    return len(out_frames) / fps  # playback duration in seconds


