# ------------------------------------------------------------------ apply --

def backup_once(rel, path):
    dest = BACKUP / rel
    if path.exists() and not dest.exists():
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, dest)


def write_files(T):
    T = dict(T)
    written = []
    for rel, tpl in TEMPLATES.items():
        text = render(tpl.replace("@HOME@", str(HOME)), T)
        path = HOME / rel
        backup_once(rel, path)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
        written.append(rel)

    # kitty: make sure colors.conf is included
    kconf = HOME / ".config/kitty/kitty.conf"
    if kconf.exists():
        body = kconf.read_text()
        if "include colors.conf" not in body:
            backup_once(".config/kitty/kitty.conf", kconf)
            kconf.write_text(body.rstrip("\n") + "\n\n# theme colors\ninclude colors.conf\n")

    # hyprland borders
    hconf = HOME / ".config/hypr/hyprland.lua"
    if hconf.exists():
        body = hconf.read_text()
        new = re.sub(
            r'(active_border\s*=\s*\{\s*colors\s*=\s*\{)[^}]*(\})',
            lambda m: '%s"rgba(%see)", "rgba(%see)"%s' % (
                m.group(1), "%02x%02x%02x" % T["ACCENT"], "%02x%02x%02x" % T["FG"], m.group(2)),
            body)
        new = re.sub(
            r'(inactive_border\s*=\s*)"[^"]*"',
            lambda m: '%s"rgba(%s99)"' % (m.group(1), "%02x%02x%02x" % T["SURFACE"]),
            new)
        new = re.sub(
            r'(shadow\s*=\s*\{[^}]*?color\s*=\s*)0x[0-9a-fA-F]{8}',
            lambda m: "%s0xee%s" % (m.group(1), "%02x%02x%02x" % T["SHADOW"]),
            new)
        if new != body:
            backup_once(".config/hypr/hyprland.lua", hconf)
            hconf.write_text(new)

    write_firefox(T)
    write_discord(T)
    write_vscode(T)
    return write_qt(T)

def write_vscode(T):
    """VS Code reads from ~/.vscode/extensions/, which also holds VS Code's own
    installed-extension metadata -- so we generate into a folder we fully own
    (.vscode-extensions, already written by the TEMPLATES above) and just
    symlink it in, rather than writing generated files directly into VS
    Code's real extensions directory on every wallpaper switch."""
    staging = HOME / ".vscode-extensions" / "wallpaper-theme"
    if not staging.exists():
        return
    for vscode_dir in (HOME / ".vscode" / "extensions",
                       HOME / ".vscode-oss" / "extensions",
                       HOME / ".var/app/com.visualstudio.code/data/vscode/extensions"):
        if not vscode_dir.parent.exists():
            continue
        vscode_dir.mkdir(parents=True, exist_ok=True)
        link = vscode_dir / "wallpaper-theme"
        if link.is_symlink() or link.exists():
            if link.resolve() == staging.resolve():
                continue
            if link.is_symlink():
                link.unlink()
            else:
                continue  # a real (non-symlink) folder is already there -- leave it alone
        try:
            link.symlink_to(staging)
        except OSError:
            pass



def write_qt(T):
    cur = SCHEME_STATE.read_text().strip() if SCHEME_STATE.exists() else ""
    name = "WallpaperB" if cur == "WallpaperA" else "WallpaperA"  # alternate so KDE always sees a change
    text = render(qt_scheme_text().replace("@SCHEME@", name), T)
    path = HOME / ".local/share/color-schemes" / (name + ".colors")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    return name


def write_firefox(T):
    text = render(FIREFOX_CSS, T)
    for base in (HOME / ".config/mozilla/firefox", HOME / ".mozilla/firefox"):
        if not base.exists():
            continue
        for prof in sorted(base.glob("*.default*")):
            if not prof.is_dir():
                continue
            path = prof / "chrome" / "userChrome.css"
            backup_once("firefox/%s/userChrome.css" % prof.name, path)
            path.parent.mkdir(exist_ok=True)
            path.write_text(text)


def write_discord(T):
    src = HOME / ".config/theme/out/wallpaper.theme.css"
    if not src.exists():
        return
    for d in (HOME / ".var/app/dev.vencord.Vesktop/config/vesktop/themes",
              HOME / ".config/vesktop/themes",
              HOME / ".config/Vencord/themes",
              HOME / ".var/app/com.discordapp.Discord/config/Vencord/themes"):
        if d.parent.exists():
            d.mkdir(exist_ok=True)
            shutil.copy2(src, d / "wallpaper.theme.css")


def run(*cmd, **kw):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, **kw)
    except FileNotFoundError:
        pass


def set_wallpaper(src):
    WALL.parent.mkdir(parents=True, exist_ok=True)
    old_copy = None
    if WALL.exists():
        old_copy = WALL.parent / ".theme-previous.jpg"
        try:
            shutil.copy2(WALL, old_copy)
        except OSError:
            old_copy = None
    Image.open(src).convert("RGB").save(WALL, "JPEG", quality=95)
    sd = HOME / ".config/theme/out/sddm"
    sd.mkdir(parents=True, exist_ok=True)
    shutil.copy2(WALL, sd / "background.jpg")
    WALLS.mkdir(parents=True, exist_ok=True)
    try:
        if Path(src).resolve().parent != WALLS.resolve():
            shutil.copy2(src, WALLS / Path(src).name)
    except OSError:
        pass
    return old_copy


def _pids(name):
    try:
        r = subprocess.run(["pgrep", "-x", name], capture_output=True, text=True)
        return [int(x) for x in r.stdout.split()]
    except (OSError, ValueError):
        return []


def start_static_wallpaper():
    """Bring up the static wallpaper FIRST and retire the old one afterwards, so the
    screen never goes blank in between. Returns pids of older swaybg instances."""
    if shutil.which("swww"):
        run("swww", "img", str(WALL), "--transition-type", "none")
        return []
    old = _pids("swaybg")
    try:
        subprocess.Popen(["swaybg", "-i", str(WALL), "-m", "fill"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except FileNotFoundError:
        return []
    return old


def retire(pids):
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass


def play_transition(old_wall, new_wall):
    """Our own animated transition: generate the reveal GIF, play it once with
    mpvpaper, then hand off to the static wallpaper. Returns True if it played."""
    if not (shutil.which("mpvpaper") and old_wall.exists()):
        return False
    try:
        duration = make_transition_gif(old_wall, new_wall, TRANSITION_GIF)
    except Exception:
        return False
    run("pkill", "mpvpaper")
    try:
        subprocess.Popen(
            ["mpvpaper", "-o", "--loop-file=no --keep-open=no --no-audio",
             "*", str(TRANSITION_GIF)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        return False
    # the animation ends in a long hold on the final wallpaper; hand off during that hold.
    time.sleep(min(duration, 4.0) + 0.1)
    old = start_static_wallpaper()   # new static wallpaper up first (looks identical to the hold frame)
    time.sleep(0.3)
    retire(old)                      # then retire the old swaybg
    run("pkill", "mpvpaper")         # and finally the animation layer
    return True


def reload_apps(scheme=None, old_wall=None, new_wall=None):
    played = old_wall is not None and new_wall is not None and play_transition(old_wall, new_wall)
    if not played:
        if shutil.which("swww"):
            run("swww", "img", str(WALL),
                "--transition-type", "grow", "--transition-pos", "0.5,0.5",
                "--transition-duration", "1.2", "--transition-fps", "60")
        else:
            old = start_static_wallpaper()
            if old:
                time.sleep(0.2)
                retire(old)
    run("pkill", "-SIGUSR2", "waybar")
    run("makoctl", "reload")
    run("swaync-client", "-rs")
    sp = HOME / ".spicetify" / "spicetify"
    run(str(sp) if sp.exists() else "spicetify", "refresh")
    run("pkill", "-SIGUSR1", "kitty")
    if scheme:
        run("plasma-apply-colorscheme", scheme)
        SCHEME_STATE.parent.mkdir(parents=True, exist_ok=True)
        SCHEME_STATE.write_text(scheme)
    run("notify-send", "theme", "recolored from your wallpaper")


# ------------------------------------------------------------------- main --

def list_walls():
    if not WALLS.exists():
        return []
    return sorted(p for p in WALLS.iterdir() if p.suffix.lower() in IMG_EXT)


def make_thumb(p):
    THUMBS.mkdir(parents=True, exist_ok=True)
    out = THUMBS / ("%s-%d.jpg" % (p.stem, int(p.stat().st_mtime)))
    if not out.exists():
        with Image.open(p) as im:
            ImageOps.fit(im.convert("RGB"), (320, 180)).save(out, "JPEG", quality=85)
    return out


def pick():
    files = list_walls()
    if not files:
        print("no wallpapers in %s" % WALLS)
        sys.exit(1)
    rows = "\n".join("%s\0icon\x1f%s" % (p.stem, make_thumb(p)) for p in files)
    cmd = ["rofi", "-dmenu", "-i", "-show-icons", "-p", "wallpaper", "-format", "s",
           "-me-select-entry", "", "-me-accept-entry", "MousePrimary"]
    theme = HOME / ".config/rofi/wallpaper.rasi"
    if theme.exists():
        cmd += ["-theme", str(theme)]
    try:
        res = subprocess.run(cmd, input=rows, text=True, capture_output=True)
    except FileNotFoundError:
        print("rofi is not installed (sudo dnf install rofi)")
        sys.exit(1)
    choice = res.stdout.strip()
    if not choice:
        sys.exit(0)
    for p in files:
        if p.stem == choice:
            return p
    sys.exit(0)


def cycle(step):
    files = list_walls()
    if not files:
        print("no wallpapers in %s" % WALLS)
        sys.exit(1)
    cur = CURRENT.read_text().strip() if CURRENT.exists() else ""
    names = [p.stem for p in files]
    i = names.index(cur) if cur in names else (-1 if step > 0 else 0)
    return files[(i + step) % len(files)]


def acquire_lock():
    """one recolor at a time, so mashing the key can't pile up runs"""
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    f = open(LOCK, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)
    return f


def main(argv):
    flags = {a for a in argv if a.startswith("--")}
    args = [a for a in argv if not a.startswith("--")]
    if not args:
        print(__doc__)
        return 1

    lock = None
    if "--dry-run" not in flags:
        lock = acquire_lock()

    if args[0] == "pick":
        src = pick()
    elif args[0] in ("next", "prev"):
        src = cycle(1 if args[0] == "next" else -1)
    elif args[0] == "random":
        files = list_walls()
        if not files:
            print("no wallpapers in %s" % WALLS)
            return 1
        src = random.choice(files)
    else:
        src = Path(args[0]).expanduser()
    if not src.exists():
        print("not found: %s" % src)
        return 1

    T = build_palette(src)
    try:
        for name in ("ACCENT", "ACCENT_DARK", "BG", "SURFACE", "FG", "FG_DIM", "GREEN"):
            print("%-12s %s" % (name, to_hex(T[name])))
    except OSError:  # stdout closed (e.g. launched from a keybind): carry on
        pass
    if "--dry-run" in flags:
        return 0

    scheme = write_files(T)
    old_wall = set_wallpaper(src)
    CURRENT.parent.mkdir(parents=True, exist_ok=True)
    CURRENT.write_text(src.stem)
    if "--no-apply" not in flags:
        reload_apps(scheme, old_wall, src)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
