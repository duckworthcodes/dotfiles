TEMPLATES[".config/theme/out/sddm/Main.qml"] = """\
import QtQuick
import QtQuick.Controls

Rectangle {
    id: root
    width: 1920
    height: 1080
    color: config.bg

    property string ui: config.font

    Image {
        anchors.fill: parent
        source: config.background
        fillMode: Image.PreserveAspectCrop
    }

    // dim the wallpaper a little so the text always reads
    Rectangle {
        anchors.fill: parent
        color: config.dim
    }

    // ---------- clock ----------
    Column {
        anchors.horizontalCenter: parent.horizontalCenter
        y: parent.height * 0.14
        spacing: 2

        Text {
            id: timeText
            anchors.horizontalCenter: parent.horizontalCenter
            color: config.fg
            font.family: root.ui
            font.pixelSize: 128
            font.bold: true
            text: Qt.formatTime(new Date(), "hh:mm")
        }

        Text {
            id: dateText
            anchors.horizontalCenter: parent.horizontalCenter
            color: config.fg
            font.family: root.ui
            font.pixelSize: 22
            text: Qt.formatDate(new Date(), "dddd, d MMMM")
        }
    }

    Timer {
        interval: 1000
        running: true
        repeat: true
        onTriggered: {
            var d = new Date()
            timeText.text = Qt.formatTime(d, "hh:mm")
            dateText.text = Qt.formatDate(d, "dddd, d MMMM")
        }
    }

    // ---------- login card ----------
    Rectangle {
        id: card
        width: 420
        height: cardColumn.implicitHeight + 56
        anchors.horizontalCenter: parent.horizontalCenter
        y: parent.height * 0.44
        radius: 22
        color: config.card
        border.color: config.accent
        border.width: 2

        Column {
            id: cardColumn
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.margins: 28
            spacing: 14

            TextField {
                id: userField
                width: parent.width
                height: 46
                text: userModel.lastUser
                placeholderText: "user"
                color: config.fg
                placeholderTextColor: config.fgdim
                font.family: root.ui
                font.pixelSize: 16
                leftPadding: 16
                selectByMouse: true
                background: Rectangle {
                    color: config.bg
                    radius: 12
                    border.width: 1
                    border.color: userField.activeFocus ? config.accent : config.border
                }
                KeyNavigation.tab: passField
                onAccepted: passField.forceActiveFocus()
            }

            TextField {
                id: passField
                width: parent.width
                height: 46
                echoMode: TextInput.Password
                placeholderText: "password"
                color: config.fg
                placeholderTextColor: config.fgdim
                font.family: root.ui
                font.pixelSize: 16
                leftPadding: 16
                background: Rectangle {
                    color: config.bg
                    radius: 12
                    border.width: 1
                    border.color: passField.activeFocus ? config.accent : config.border
                }
                KeyNavigation.tab: sessionBox
                onAccepted: root.doLogin()
            }

            ComboBox {
                id: sessionBox
                width: parent.width
                height: 42
                model: sessionModel
                textRole: "name"
                currentIndex: sessionModel.lastIndex
                font.family: root.ui
                font.pixelSize: 14
                KeyNavigation.tab: loginButton

                background: Rectangle {
                    color: config.bg
                    radius: 12
                    border.width: 1
                    border.color: config.border
                }
                contentItem: Text {
                    leftPadding: 16
                    text: sessionBox.displayText
                    color: config.fgdim
                    font: sessionBox.font
                    verticalAlignment: Text.AlignVCenter
                    elide: Text.ElideRight
                }
                delegate: ItemDelegate {
                    width: sessionBox.width
                    highlighted: sessionBox.highlightedIndex === index
                    contentItem: Text {
                        text: model.name
                        color: parent.highlighted ? config.surface : config.fg
                        font: sessionBox.font
                        verticalAlignment: Text.AlignVCenter
                    }
                    background: Rectangle {
                        color: parent.highlighted ? config.accent : config.surface
                    }
                }
                popup: Popup {
                    y: sessionBox.height + 4
                    width: sessionBox.width
                    implicitHeight: contentItem.implicitHeight
                    padding: 1
                    contentItem: ListView {
                        clip: true
                        implicitHeight: contentHeight
                        model: sessionBox.popup.visible ? sessionBox.delegateModel : null
                        currentIndex: sessionBox.highlightedIndex
                    }
                    background: Rectangle {
                        color: config.surface
                        radius: 10
                        border.color: config.border
                    }
                }
            }

            Text {
                id: errorText
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                color: config.error
                font.family: root.ui
                font.pixelSize: 14
                text: ""
                visible: text !== ""
            }

            Button {
                id: loginButton
                width: parent.width
                height: 46
                text: "log in"
                font.family: root.ui
                font.pixelSize: 16
                font.bold: true
                contentItem: Text {
                    text: loginButton.text
                    font: loginButton.font
                    color: config.surface
                    horizontalAlignment: Text.AlignHCenter
                    verticalAlignment: Text.AlignVCenter
                }
                background: Rectangle {
                    radius: 12
                    color: loginButton.down || loginButton.hovered ? config.accentlight : config.accent
                }
                KeyNavigation.tab: userField
                onClicked: root.doLogin()
            }
        }
    }

    // ---------- power buttons ----------
    Row {
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        anchors.margins: 32
        spacing: 12

        Repeater {
            model: [
                { label: "suspend", ok: sddm.canSuspend, act: 0 },
                { label: "reboot", ok: sddm.canReboot, act: 1 },
                { label: "shutdown", ok: sddm.canPowerOff, act: 2 }
            ]
            delegate: Rectangle {
                visible: modelData.ok
                width: powerLabel.implicitWidth + 32
                height: 38
                radius: 12
                color: powerArea.containsMouse ? config.accent : config.card
                border.color: config.border
                border.width: 1
                Text {
                    id: powerLabel
                    anchors.centerIn: parent
                    text: modelData.label
                    color: powerArea.containsMouse ? config.surface : config.fg
                    font.family: root.ui
                    font.pixelSize: 14
                }
                MouseArea {
                    id: powerArea
                    anchors.fill: parent
                    hoverEnabled: true
                    onClicked: {
                        if (modelData.act === 0) sddm.suspend()
                        else if (modelData.act === 1) sddm.reboot()
                        else sddm.powerOff()
                    }
                }
            }
        }
    }

    function doLogin() {
        errorText.text = ""
        sddm.login(userField.text, passField.text, sessionBox.currentIndex)
    }

    Connections {
        target: sddm
        function onLoginFailed() {
            errorText.text = "wrong password"
            passField.text = ""
            passField.forceActiveFocus()
        }
    }

    Component.onCompleted: {
        if (userField.text === "")
            userField.forceActiveFocus()
        else
            passField.forceActiveFocus()
    }
}
"""

