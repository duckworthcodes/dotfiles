#!/usr/bin/env python3
"""theme: recolor the whole rice from a wallpaper.

  theme <image>            set wallpaper + recolor everything
  theme pick               thumbnail grid of ~/Pictures/wallpapers, click one to apply
  theme random             random wallpaper from ~/Pictures/wallpapers
  theme next | prev        step through ~/Pictures/wallpapers in order
  theme <image> --dry-run  only print the palette, change nothing

Options: --no-apply  write the files but don't reload apps or set the wallpaper
"""
import colorsys
import fcntl
import os
import random
import re
import shutil
import subprocess
import sys
from pathlib import Path

from PIL import Image, ImageOps

HOME = Path(os.environ.get("HOME", str(Path.home())))
WALLS = HOME / "Pictures" / "MyWalls"
WALL = HOME / "Pictures" / "wallpaper.jpg"
BACKUP = HOME / ".config" / "theme" / "backup"
THUMBS = HOME / ".cache" / "theme" / "thumbs"
CURRENT = HOME / ".cache" / "theme" / "current"
LOCK = HOME / ".cache" / "theme" / "lock"
SCHEME_STATE = HOME / ".cache" / "theme" / "scheme"
IMG_EXT = {".jpg", ".jpeg", ".png", ".webp"}


# ---------------------------------------------------------------- palette --

def extract(path):
    img = Image.open(path).convert("RGB")
    img.thumbnail((200, 200))
    q = img.quantize(colors=24, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette()
    total = sum(n for n, _ in q.getcolors())
    out = []
    for n, idx in sorted(q.getcolors(), reverse=True):
        out.append(((pal[idx * 3], pal[idx * 3 + 1], pal[idx * 3 + 2]), n / total))
    return out


def hue_dist(a, b):
    d = abs(a - b) % 1.0
    return min(d, 1.0 - d)


def pick_accent(colors):
    best, best_score = None, 0.0
    for (r, g, b), share in colors:
        h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        if s < 0.35 or v < 0.35:
            continue
        score = (s ** 1.5) * (v ** 0.5) * (share ** 0.4)
        if score > best_score:
            best, best_score = (r, g, b), score
    if best is None:  # very dull image: take the most colorful pixel anyway
        best = max(colors, key=lambda c: colorsys.rgb_to_hsv(*[x / 255 for x in c[0]])[1])[0]
    h, l, s = colorsys.rgb_to_hls(*[x / 255 for x in best])
    return h, min(max(s, 0.60), 0.95)


def pick_fg_hue(colors, accent_h):
    best, best_share = None, 0.0
    for (r, g, b), share in colors:
        h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        if v < 0.8 or not (0.25 <= s <= 0.75):
            continue
        if hue_dist(h, accent_h) < 0.07:
            continue
        if share > best_share:
            best, best_share = h, share
    return best if best is not None else 0.10  # warm cream reads well on any dark tint


def build_palette(path):
    colors = extract(path)
    ha, sa = pick_accent(colors)
    hf = pick_fg_hue(colors, ha)

    def hls(h, l, s):
        r, g, b = colorsys.hls_to_rgb(h % 1.0, l, s)
        return (round(r * 255), round(g * 255), round(b * 255))

    T = {
        "ACCENT": hls(ha, 0.62, sa),
        "ACCENT_DARK": hls(ha, 0.48, min(sa, 0.90)),
        "ACCENT_LIGHT": hls(ha, 0.72, sa),
        "BG": hls(ha, 0.13, 0.28),
        "SURFACE": hls(ha, 0.19, 0.27),
        "SURFACE_HI": hls(ha, 0.30, 0.20),
        "VIEW": hls(ha, 0.11, 0.30),
        "CRIT_BG": hls(ha, 0.20, 0.50),
        "BORDER": hls(ha, 0.25, 0.20),
        "SHADOW": hls(ha, 0.06, 0.40),
        "FG": hls(hf, 0.80, 0.55),
        "FG_DIM": hls(hf, 0.62, 0.38),
        "FG_BRIGHT": hls(hf, 0.92, 0.60),
    }
    for name, hue in (("GREEN", 0.39), ("YELLOW", 0.115), ("BLUE", 0.57),
                      ("MAGENTA", 0.90), ("CYAN", 0.47)):
        T[name] = hls(hue, 0.62, 0.30)
        T[name + "_BRIGHT"] = hls(hue, 0.74, 0.35)
    return T


def to_hex(c):
    return "#%02x%02x%02x" % c


def render(tpl, T):
    def sub(m):
        key = m.group(1)
        if key in T:
            return to_hex(T[key])
        for suffix, fmt in (("_HEX", lambda c: "%02x%02x%02x" % c),
                            ("_RGB", lambda c: "%d, %d, %d" % c),
                            ("_SEMI", lambda c: "%d;%d;%d" % c),
                            ("_CSV", lambda c: "%d,%d,%d" % c)):
            if key.endswith(suffix) and key[: -len(suffix)] in T:
                return fmt(T[key[: -len(suffix)]])
        raise KeyError("unknown token @%s@" % key)

    return re.sub(r"@([A-Z0-9_]+)@", sub, tpl)


