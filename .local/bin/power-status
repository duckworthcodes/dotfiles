#!/bin/sh
# power-status: prints JSON for the Waybar custom/power-profile module,
# so the CSS class (and therefore the colour) actually changes per profile.
cur=$(tuned-adm active | grep -oP '(?<=profile: ).*')
printf '{"text": " %s", "class": "%s", "tooltip": "power profile: %s (click to cycle)"}\n' \
    "$cur" "$cur" "$cur"
